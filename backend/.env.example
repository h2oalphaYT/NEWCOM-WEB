PORT=8090

# Database: same SQL Server as Newcom Inventory (copy the DB_* values from its backend/.env).
# Prefer a login that only has SELECT/EXECUTE-on-functions rights; this API never writes.
DB_HOST=
DB_PORT=1433
DB_NAME=
DB_USER=
DB_PASSWORD=

# Company whose stock is shown on the public site (cCompanyCode in the inventory DB)
COMPANY_CODE=

# Comma-separated origins allowed to call this API (the Next.js site)
consumer_origin=http://localhost:3000

# Item images: same S3 bucket as the inventory (copy from NEWCOM-Web-Service/backend/.env)
AWS_REGION=ap-southeast-1
AWS_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Website database (created by: go run ./cmd/migrate) and sessions
WEB_DB_NAME=NEWCOM_WEB
# comma-separated website origins allowed to call the API with cookies (production: https://www.newcom.lk)
WEB_ORIGIN=http://localhost:3000
# set to true when the site is served over https
COOKIE_SECURE=false
# JWT_KEY signs admin and customer sessions: use a long random value
JWT_KEY=
